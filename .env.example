# Citizen's Record local/recovery configuration template
# Copy to a local secret store or managed environment. Never commit actual values.

# Runtime and data
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Managed Forge/storage integration
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Billing — use matching test or live values, never mix modes
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOTION_DRAFTING_PRICE_ID=
# If the client uses Stripe.js in the managed deployment, configure the client-safe key there.
VITE_STRIPE_PUBLISHABLE_KEY=
